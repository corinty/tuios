+func writeMockProvider(t *testing.T, handledRepo, createdPath string) string {
+	t.Helper()
+	if runtime.GOOS == "windows" {
+		t.Skip("mock provider shell script requires unix")
+	}
+	dir := t.TempDir()
+	script := filepath.Join(dir, "provider.sh")
+	content := fmt.Sprintf(`#!/usr/bin/env bash
+set -euo pipefail
+verb="${1:-}"
+shift || true
+repo=""
+branch=""
+base=""
+path=""
+force=0
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --repo) repo="$2"; shift 2 ;;
+    --branch) branch="$2"; shift 2 ;;
+    --base) base="$2"; shift 2 ;;
+    --path) path="$2"; shift 2 ;;
+    --force) force=1; shift ;;
+    *) shift ;;
+  esac
+done
+
+case "$verb" in
+  detect)
+    if [ "$repo" = "%s" ]; then
+      printf '{"handled":true}\n'
+    else
+      printf '{"handled":false}\n'
+    fi
+    ;;
+  resolve)
+    printf '{"path":"%s"}\n'
+    ;;
+  create)
+    printf '{"path":"%s"}\n'
+    ;;
+  list)
+    printf '[{"path":"%s","branch":"main","detached":false}]\n'
+    ;;
+  remove)
+    printf '{}\n'
+    ;;
+  *)
+    echo "unknown verb $verb" >&2
+    exit 2
+    ;;
+esac
